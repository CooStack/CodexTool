/**
 * Own the hidden OpenGL context, stable artifact directories, and metadata used
 * by offscreen tests against the project's standalone shader API.
 *
 * In a CooParticlesAPI-style project, this extension should serve tests that stay
 * inside abstractions such as CooShaderProgram, GlFrameBuffer, VertexBuffer,
 * GlTexture, ShaderPipe, and PipeLinker.
 */
class ShaderTestExtension : BeforeAllCallback, AfterAllCallback, ParameterResolver {
    private lateinit var runtime: ShaderTestRuntime

    override fun beforeAll(context: ExtensionContext) {
        val projectRoot = Path.of("").toAbsolutePath()
        val artifactRoot = projectRoot.resolve("build/test-artifacts/shaders")
        Files.createDirectories(artifactRoot)

        runtime = ShaderTestRuntime(
            projectRoot = projectRoot,
            artifactRoot = artifactRoot,
            baselineRoot = projectRoot.resolve("src/test/resources/shader-baselines"),
            sceneRoot = projectRoot.resolve("src/test/resources/shader-scenes"),
            contextHandle = createHiddenContext(),
            glVersion = queryGlVersion(),
            driverString = queryDriverString(),
        )
    }

    override fun afterAll(context: ExtensionContext) {
        if (::runtime.isInitialized) {
            destroyHiddenContext(runtime.contextHandle)
        }
    }

    override fun supportsParameter(
        parameterContext: ParameterContext,
        extensionContext: ExtensionContext,
    ): Boolean = parameterContext.parameter.type == ShaderTestRuntime::class.java

    override fun resolveParameter(
        parameterContext: ParameterContext,
        extensionContext: ExtensionContext,
    ): Any = runtime

